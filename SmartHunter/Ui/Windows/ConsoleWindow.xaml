<Window x:Class="SmartHunter.Ui.Windows.ConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SmartHunter.Game.Data.ViewModels"
        xmlns:helpers="clr-namespace:SmartHunter.Game.Helpers"
        xmlns:controls="clr-namespace:SmartHunter.Ui.Controls"
        Title="SmartHunter" Width="1120" Height="780" MinWidth="850" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F7F5F1" Foreground="#203047"
        FontFamily="Segoe UI, Microsoft JhengHei" FontSize="{Binding InterfaceFontSize}" UseLayoutRounding="True"
        DataContext="{x:Static vm:SettingsViewModel.Instance}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="16,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#D8E0E9"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F5F0E8"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9A7142"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EADFCC"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Width="46" Height="32" Background="Transparent">
                    <Border x:Name="Track" Height="24" CornerRadius="12" Background="#CBD5E1"/>
                    <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#9A7142"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#203047"/><Setter TargetName="Track" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,13"/><Setter Property="Margin" Value="0,3"/>
            <Setter Property="Foreground" Value="#65748B"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="NavSurface" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#F0F5F6"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#F1E8DC"/><Setter Property="Foreground" Value="#825D32"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="#9A7142"/><Setter TargetName="NavSurface" Property="BorderThickness" Value="1"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Image x:Name="WildsBackdrop" Grid.ColumnSpan="2" Source="{Binding BackgroundImage}" Stretch="UniformToFill" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform><ScaleTransform ScaleX="1.025" ScaleY="1.025"/></Image.RenderTransform>
            <Image.Effect><BlurEffect Radius="5" RenderingBias="Performance"/></Image.Effect>
        </Image>
        <Border Grid.ColumnSpan="2" IsHitTestVisible="False">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#B3F9F6EF" Offset="0"/><GradientStop Color="#40F4EBD8" Offset="1"/></LinearGradientBrush></Border.Background>
        </Border>
        <Border Background="#DCFFFFFF" BorderBrush="#C0FFFFFF" BorderThickness="0,0,1,0" Padding="18,28,18,20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="8,0,0,32">
                    <Border Width="40" Height="40" Background="#9A7142" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <TextBlock Text="SH" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SmartHunter" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ActiveGameProfile}" FontSize="{Binding InterfaceSmallFontSize}" Foreground="#8390A2" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <Button x:Name="ShareWebButton" Command="{Binding ShareWebLink}" IsEnabled="{Binding CanShareWeb}" Margin="0,12,0,0" Padding="9,8" ToolTip="{Binding ShareWebHint}" AutomationProperties.Name="{Binding ShareWebLabel}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="{Binding ShareWebLabel}" FontSize="{Binding InterfaceBodyFontSize}" TextWrapping="Wrap" MaxWidth="132"/></StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,20,0,0">
                    <Button x:Name="UpdateButton" Content="{Binding UpdateActionText}" Command="{Binding UpdateAction}" IsEnabled="{Binding CanUpdate}" Padding="8,6" FontSize="{Binding InterfaceBodyFontSize}"/>
                    <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="#718096" FontSize="{Binding InterfaceSmallFontSize}" Margin="0,5,0,8"/>
                    <TextBlock Text="{Binding Version}" Foreground="#7C899A" FontSize="{Binding InterfaceBodyFontSize, Source={x:Static vm:SettingsViewModel.Instance}}"/>
                </StackPanel>
                <ListBox x:Name="Navigation" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate><DataTemplate><Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" FontWeight="Normal"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap"/>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Border Grid.Column="1" Margin="20" Padding="20,14,20,0" CornerRadius="18" Background="#C9FAF8F2" BorderBrush="#BDFFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="48"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedSection.Name}" FontSize="{Binding InterfaceTitleFontSize}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding SelectedSection.Description}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="{Binding [LOC_UI_EDIT_PROFILE], Source={x:Static helpers:UiText.Instance}}" Foreground="#718096" FontSize="{Binding InterfaceSmallFontSize}" Margin="0,0,0,3"/>
                    <ComboBox ItemsSource="{Binding ProfileOptions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedEditingProfile}" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" Padding="8,5" FontSize="{Binding InterfaceFontSize}"/>
                    <TextBlock Text="{Binding EditingNotice}" Foreground="#718096" FontSize="{Binding InterfaceSmallFontSize}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding [LOC_UI_PROFILE_LANGUAGE], Source={x:Static helpers:UiText.Instance}}" Foreground="#718096" FontSize="{Binding InterfaceSmallFontSize}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="LanguagePicker" ItemsSource="{Binding Languages}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedLanguage}" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="DisplayName" Padding="8,5" FontSize="{Binding InterfaceFontSize}" AutomationProperties.Name="Language"/>
                    <TextBlock Text="{Binding GameVersionLabel, Source={x:Static vm:ConsoleViewModel.Instance}}" Foreground="#718096" FontSize="{Binding InterfaceSmallFontSize}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="#FFF4DB" BorderBrush="#F5DCA4" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Visibility="{Binding RestartNeeded, Converter={StaticResource BoolVisibility}}">
                <DockPanel><Button Content="{Binding [LOC_UI_RESTART], Source={x:Static helpers:UiText.Instance}}" Command="{Binding Restart}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                    <TextBlock Text="{Binding [LOC_UI_RESTART_HINT], Source={x:Static helpers:UiText.Instance}}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#846325" FontSize="{Binding InterfaceBodyFontSize, Source={x:Static vm:SettingsViewModel.Instance}}"/>
                </DockPanel>
            </Border>
            <Grid Grid.Row="2" x:Name="SettingsPanel">
                <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsLogs}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Border CornerRadius="8" BorderBrush="#D9FFFFFF" BorderThickness="1" Background="#D9FFFFFF" Padding="14,10" Margin="0,0,0,18">
                    <DockPanel>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#8A99AB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button DockPanel.Dock="Right" Padding="5,0" BorderThickness="0" Content="×" Click="ClearSearch_Click" AutomationProperties.Name="Clear search"/>
                        <Grid><TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="{Binding InterfaceFontSize, Source={x:Static vm:SettingsViewModel.Instance}}" AutomationProperties.Name="Search settings"/>
                            <TextBlock IsHitTestVisible="False" Text="{Binding [LOC_UI_SEARCH], Source={x:Static helpers:UiText.Instance}}" Foreground="#94A0B1" FontSize="{Binding InterfaceFontSize, Source={x:Static vm:SettingsViewModel.Instance}}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1">
                    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                        <ItemsControl ItemsSource="{Binding FilteredSettings}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border CornerRadius="10" Background="#DFFFFFFF" BorderBrush="#E6FFFFFF" BorderThickness="1" Padding="20,17" Margin="0,0,0,10">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,26,0">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="{Binding InterfaceFontSize, Source={x:Static vm:SettingsViewModel.Instance}}"/>
                                            <TextBlock Text="{Binding Description}" Foreground="#738197" FontSize="{Binding InterfaceBodyFontSize, Source={x:Static vm:SettingsViewModel.Instance}}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="{Binding [LOC_UI_NEXT_START], Source={x:Static helpers:UiText.Instance}}" Foreground="#AD7D31" FontSize="{Binding InterfaceSmallFontSize, Source={x:Static vm:SettingsViewModel.Instance}}" Margin="0,7,0,0" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolVisibility}}"/>
                                            <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Foreground="#9A7142" FontSize="{Binding InterfaceBodyFontSize, Source={x:Static vm:SettingsViewModel.Instance}}" Margin="0,7,0,0" Visibility="{Binding IsAction, Converter={StaticResource BoolVisibility}}"/>
                                            <TextBlock Text="{Binding ValidationMessage}" Foreground="#B33C32" TextWrapping="Wrap" FontSize="{Binding InterfaceBodyFontSize, Source={x:Static vm:SettingsViewModel.Instance}}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Value, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" Style="{StaticResource Toggle}" Visibility="{Binding IsToggle, Converter={StaticResource BoolVisibility}}"/>
                                        <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="220" Padding="10,8" VerticalContentAlignment="Center" VerticalAlignment="Center" BorderBrush="#D8E0E9" FontSize="{Binding InterfaceFontSize, Source={x:Static vm:SettingsViewModel.Instance}}" Visibility="{Binding IsText, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding Name}"/>
                                        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,10,0,0" Padding="10,8" TextWrapping="Wrap" BorderBrush="#D8E0E9" FontSize="{Binding InterfaceFontSize, Source={x:Static vm:SettingsViewModel.Instance}}" Visibility="{Binding IsWideText, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding Name}"/>
                                        <StackPanel Grid.Column="1" Width="220" VerticalAlignment="Center" Visibility="{Binding IsColor, Converter={StaticResource BoolVisibility}}">
                                            <DockPanel><Button Click="PickColor_Click" Padding="5" DockPanel.Dock="Left" Margin="0,0,7,0" ToolTip="{Binding [LOC_UI_COLOR_PICK], Source={x:Static helpers:UiText.Instance}}" AutomationProperties.Name="{Binding Name}"><Border Width="26" Height="26" Background="{Binding ColorPreview}" BorderBrush="#A6B2C1" BorderThickness="1"/></Button><TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Padding="7,8" FontFamily="Consolas" VerticalContentAlignment="Center" ToolTip="{Binding [LOC_UI_COLOR_HEX_HINT], Source={x:Static helpers:UiText.Instance}}"/></DockPanel>
                                            <Button Content="{Binding [LOC_UI_COLOR_DEFAULT], Source={x:Static helpers:UiText.Instance}}" Command="{Binding Reset}" Margin="0,6,0,0" Padding="9,5" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}" DisplayMemberPath="Name" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Name" MinWidth="150" MaxWidth="200" Padding="10,7" FontSize="{Binding InterfaceFontSize, Source={x:Static vm:SettingsViewModel.Instance}}" VerticalAlignment="Center" Visibility="{Binding IsChoice, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="{Binding Name}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding IsAction, Converter={StaticResource BoolVisibility}}">
                                            <Button Content="{Binding ActionText}" Command="{Binding Action}"/>
                                            <Button Content="{Binding [LOC_UI_BACKGROUND_RESET], Source={x:Static helpers:UiText.Instance}}" Command="{Binding Reset}" Margin="0,6,0,0" Visibility="{Binding CanReset, Converter={StaticResource BoolVisibility}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="{Binding [LOC_UI_NO_RESULTS], Source={x:Static helpers:UiText.Instance}}" Foreground="#718096" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoResults, Converter={StaticResource BoolVisibility}}"/>
                </Grid>
            </Grid>
            <Grid Grid.Row="2" DataContext="{x:Static vm:ConsoleViewModel.Instance}" Visibility="{Binding IsLogs, Source={x:Static vm:SettingsViewModel.Instance}, Converter={StaticResource BoolVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="{Binding [LOC_UI_COPY], Source={x:Static helpers:UiText.Instance}}" Click="CopyLogs_Click" Margin="0,0,8,0"/><Button Content="{Binding [LOC_UI_CLEAR], Source={x:Static helpers:UiText.Instance}}" Click="ClearLogs_Click"/></StackPanel>
                    <CheckBox Content="{Binding [LOC_UI_AUTOSCROLL], Source={x:Static helpers:UiText.Instance}}" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" FontSize="{Binding InterfaceBodyFontSize, Source={x:Static vm:SettingsViewModel.Instance}}"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                    <Border Background="#E8FFFFFF" CornerRadius="10" BorderBrush="#E6FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding RelayStatus}" Foreground="#274A61" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="{Binding InterfaceBodyFontSize, Source={x:Static vm:SettingsViewModel.Instance}}"/>
                            <TextBlock Text="{Binding RelayStatistics}" Foreground="#44566C" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="{Binding InterfaceFontSize, Source={x:Static vm:SettingsViewModel.Instance}}"/>
                            <TextBlock Text="{Binding RelayApplication}" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="{Binding InterfaceFontSize, Source={x:Static vm:SettingsViewModel.Instance}}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="#E8FFFFFF" CornerRadius="10" BorderBrush="#E6FFFFFF" BorderThickness="1" Padding="16">
                        <controls:ScrollingTextBox x:Name="LogText" Text="{Binding Output, Mode=OneWay}" AutoScroll="{Binding AutoScroll}" IsReadOnly="True" BorderThickness="0" Foreground="#44566C" Background="Transparent" FontFamily="Consolas, Microsoft JhengHei" FontSize="{Binding InterfaceFontSize, Source={x:Static vm:SettingsViewModel.Instance}}" TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" AcceptsReturn="True" AutomationProperties.Name="Diagnostic log"/>
                    </Border>
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding [LOC_UI_LOG_LIMIT], Source={x:Static helpers:UiText.Instance}}" Foreground="#8390A2" FontSize="{Binding InterfaceSmallFontSize, Source={x:Static vm:SettingsViewModel.Instance}}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </Grid>
            <DockPanel Grid.Row="3" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Right" Text="{Binding [LOC_UI_AUTOSAVED], Source={x:Static helpers:UiText.Instance}}" Foreground="#718096" FontSize="{Binding InterfaceSmallFontSize, Source={x:Static vm:SettingsViewModel.Instance}}"/>
                <Ellipse Fill="#9A7142" Width="6" Height="6" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Status, Source={x:Static vm:ConsoleViewModel.Instance}}" Foreground="#65748B" FontSize="{Binding InterfaceSmallFontSize, Source={x:Static vm:SettingsViewModel.Instance}}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status, Source={x:Static vm:ConsoleViewModel.Instance}}" Margin="0,0,12,0"/>
            </DockPanel>
        </Grid>
        </Border>
    </Grid>
</Window>
