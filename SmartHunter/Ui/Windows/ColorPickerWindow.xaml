<Window x:Class="SmartHunter.Ui.Windows.ColorPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:helpers="clr-namespace:SmartHunter.Game.Helpers" Title="{Binding [LOC_UI_COLOR_PICK], Source={x:Static helpers:UiText.Instance}}"
 Width="440" Height="555" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#F7F5F1" Foreground="#203047" FontFamily="Segoe UI, Microsoft JhengHei" FontSize="16" ShowInTaskbar="False">
 <Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="3"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8E0E9"/></Style></Window.Resources>
 <Grid Margin="24" Background="#F7F5F1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="90"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding [LOC_UI_COLOR_PICK_HINT], Source={x:Static helpers:UiText.Instance}}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,14"/>
  <Border Grid.Row="1" CornerRadius="10" BorderBrush="#D8E0E9" BorderThickness="1" ClipToBounds="True">
   <Border.Background><DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="White" Geometry="M0,0 H16 V16 H0 Z"/><GeometryDrawing Brush="#D8DEE5" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z"/></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Border.Background>
   <Border Background="{Binding Preview}"/>
  </Border>
  <StackPanel Grid.Row="2" Margin="0,14,0,6"><TextBox Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" Padding="10,8" AutomationProperties.Name="ARGB"/><TextBlock Text="{Binding Error}" Foreground="#B33C32" TextWrapping="Wrap" FontSize="13"/></StackPanel>
  <StackPanel Grid.Row="3">
   <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="{Binding [LOC_UI_COLOR_OPACITY], Source={x:Static helpers:UiText.Instance}}"/><Slider Grid.Column="1" Value="{Binding Opacity}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"/></Grid>
   <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="R"/><Slider Grid.Column="1" Value="{Binding R}" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Column="2" Text="{Binding R, StringFormat=F0}" HorizontalAlignment="Right"/></Grid>
   <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="G"/><Slider Grid.Column="1" Value="{Binding G}" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Column="2" Text="{Binding G, StringFormat=F0}" HorizontalAlignment="Right"/></Grid>
   <Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="B"/><Slider Grid.Column="1" Value="{Binding B}" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"/><TextBlock Grid.Column="2" Text="{Binding B, StringFormat=F0}" HorizontalAlignment="Right"/></Grid>
   <WrapPanel Margin="0,12,0,0"><Button Background="White" Width="32" Height="28" Tag="#FFFFFFFF" Click="Preset_Click" AutomationProperties.Name="White"/><Button Background="Black" Width="32" Height="28" Tag="#FF000000" Click="Preset_Click" AutomationProperties.Name="Black"/><Button Background="#00CCCC" Width="32" Height="28" Tag="#FF00CCCC" Click="Preset_Click" AutomationProperties.Name="Cyan"/><Button Background="#CC0000" Width="32" Height="28" Tag="#FFCC0000" Click="Preset_Click" AutomationProperties.Name="Red"/><Button Background="#3366CC" Width="32" Height="28" Tag="#FF3366CC" Click="Preset_Click" AutomationProperties.Name="Blue"/><Button Background="#33BB33" Width="32" Height="28" Tag="#FF33BB33" Click="Preset_Click" AutomationProperties.Name="Green"/><Button Background="#FCB252" Width="32" Height="28" Tag="#FFFCB252" Click="Preset_Click" AutomationProperties.Name="Amber"/></WrapPanel>
  </StackPanel>
  <DockPanel Grid.Row="4"><Button Content="{Binding [LOC_UI_COLOR_DEFAULT], Source={x:Static helpers:UiText.Instance}}" Click="Default_Click" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{Binding [LOC_UI_COLOR_CANCEL], Source={x:Static helpers:UiText.Instance}}" IsCancel="True"/><Button Content="{Binding [LOC_UI_COLOR_APPLY], Source={x:Static helpers:UiText.Instance}}" IsEnabled="{Binding Valid}" IsDefault="True" Click="Apply_Click"/></StackPanel></DockPanel>
 </Grid>
</Window>
