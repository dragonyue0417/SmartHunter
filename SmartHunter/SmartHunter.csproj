        <AssemblyTitle>SmartHunter</AssemblyTitle>
        <AssemblyName>SmartHunter</AssemblyName>
        <RootNamespace>SmartHunter</RootNamespace>
        <Deterministic>false</Deterministic>
        <AssemblyVersion>2026.10.31.6</AssemblyVersion>
        <FileVersion>2026.10.31.6</FileVersion>
