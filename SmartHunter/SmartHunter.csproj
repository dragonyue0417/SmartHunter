        <Reference Include="System.Xaml" />
        <Reference Include="WindowsBase" />
        <Reference Include="PresentationCore" />
        <Reference Include="PresentationFramework" />
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Include="Languages\*.json" />
        <EmbeddedResource Include="World\Languages\*.json" />
        <EmbeddedResource Include="Wilds\Data\*.json" />
        <Resource Include="Ui\Fonts\Roboto-Bold.ttf" />
        <Resource Include="Ui\Fonts\Roboto-Medium.ttf" />
        <Resource Include="Ui\Images\WildsBackdrop.jpg" />
    </ItemGroup>
</Project>
